int romanToInt(string s)
{
int n=s.size();
int max=0;
int total=0;
for(int i=n-1;i>=0;--i)
{
int current=0;
switch(s[i])
{
case 'I':current=1;break;
case 'V':current=5;break;
case 'X':current=10;break;
case 'L':current=50;break;
case 'C':current=100;break;
case 'M':current=500;break;
case 'D':current=1000;break;
}
if(current<max)
total-=current;
else{
total+=current;
max=current;
}
}
return total;
}
